{
  "name": "chesskids-academy",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && astro preview",
    "check": "astro check",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "wrangler d1 migrations apply chesskids --local",
    "db:migrate:remote": "wrangler d1 migrations apply chesskids --remote",
    "setup": "npm run db:migrate && npm run db:seed",
    "deploy": "astro build && wrangler deploy",
    "db:seed": "wrangler d1 execute chesskids --local --file=seed/demo.sql",
    "push": "node scripts/push.mjs",
    "push:deploy": "npm run push && npm run deploy",
    "voices": "tsx scripts/voices/generate.ts",
    "puzzles:build": "tsx scripts/lichess/build.ts",
    "puzzles:load": "tsx scripts/lichess/load.ts",
    "push:keys": "tsx scripts/push/vapid.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/preact": "^6.0.5",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@lichess-org/chessground": "^10.4.0",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^7.3.5",
    "canvas-confetti": "^1.9.3",
    "chess.js": "^1.4.0",
    "preact": "^10.27.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260928.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.143.0"
  }
}

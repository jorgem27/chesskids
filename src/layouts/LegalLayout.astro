---
import Base from './Base.astro';
interface Props { title: string }
const { title } = Astro.props;
---
<Base title={`${title} · Odisea Miranda`}>
  <div class="min-h-dvh bg-[#f3f5fa]">
    <header class="om-night">
      <div class="mx-auto flex max-w-3xl items-center gap-3 px-4 py-3">
        <a href="/" class="flex items-center gap-2 font-brand text-lg font-bold om-gold-text"><img src="/brand/logo-96.webp" width="36" height="36" alt="" />Odisea Miranda</a>
      </div>
      <div class="om-meander"></div>
    </header>
    <main class="ck-legal mx-auto max-w-3xl px-4 py-8 text-slate-700">
      <slot />
      <p class="mt-10 flex flex-wrap gap-4 border-t border-slate-200 pt-4 text-sm font-bold">
        <a href="/" class="text-brand-700">← Inicio</a>
        <a href="/privacidad" class="text-brand-700">Privacidad</a>
        <a href="/aviso-legal" class="text-brand-700">Aviso legal</a>
      </p>
    </main>
  </div>
</Base>
<style is:global>
  .ck-legal h1 { font-family: var(--font-display, inherit); font-size: 2rem; font-weight: 800; color: #162750; line-height: 1.15; }
  .ck-legal h2 { margin-top: 2rem; font-size: 1.25rem; font-weight: 800; color: #162750; }
  .ck-legal p, .ck-legal li { margin-top: .6rem; line-height: 1.6; }
  .ck-legal ul { list-style: disc; padding-left: 1.4rem; }
  .ck-legal table { margin-top: .8rem; width: 100%; border-collapse: collapse; font-size: .9rem; }
  .ck-legal th, .ck-legal td { border: 1px solid #dbe5f6; padding: .5rem; text-align: left; vertical-align: top; }
  .ck-legal th { background: #eef3fb; }
</style>

---
import Base from './Base.astro';
interface Props { title?: string }
const { title = 'ChessKids' } = Astro.props;
const s = Astro.locals.student!;
const path = Astro.url.pathname;
const tabs = [
  { href: '/app', icon: '🏠', label: 'Inicio', active: path === '/app' || path === '/app/' },
  { href: '/app/mapa', icon: '🗺️', label: 'Mapa', active: path.startsWith('/app/mapa') },
  { href: '/app/album', icon: '📒', label: 'Álbum', active: path.startsWith('/app/album') },
];
---
<Base title={title} age={s.age_group}>
  <div class="min-h-dvh bg-gradient-to-b from-violet-100 via-fuchsia-50 to-amber-50 pb-28 md:pb-10">
    <nav class="fixed inset-x-0 bottom-0 z-30 border-t-2 border-violet-100 bg-white/95 backdrop-blur md:static md:border-0 md:bg-transparent">
      <div class="mx-auto flex max-w-5xl items-center justify-around px-2 py-2 md:justify-start md:gap-3 md:px-6 md:pt-5">
        <a href="/app" class="mr-auto hidden items-center gap-2 font-display text-2xl font-extrabold text-violet-700 md:flex"><span class="text-3xl">♞</span> ChessKids</a>
        {tabs.map((t) => (
          <a href={t.href} class={`flex flex-col items-center rounded-2xl px-5 py-1.5 font-display font-extrabold md:flex-row md:gap-2 md:py-2 ${t.active ? 'bg-violet-600 text-white shadow-[0_4px_0_#5b21b6]' : 'text-slate-500 hover:bg-white'}`}>
            <span class="text-2xl">{t.icon}</span><span class="text-xs md:text-base">{t.label}</span>
          </a>
        ))}
      </div>
    </nav>
    <main class="mx-auto max-w-5xl px-4 pt-4 md:px-6">
      <slot />
    </main>
  </div>
</Base>

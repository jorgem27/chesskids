---
import Base from './Base.astro';
import Logo from '../components/ui/Logo.astro';
import { levelFromXp } from '../lib/rewards';
import { today } from '../lib/db';
import { addDays } from '../lib/dates';
interface Props { title?: string }
const { title = 'Odisea Miranda' } = Astro.props;
const s = Astro.locals.student!;
const path = Astro.url.pathname;
const streak = s.last_active_day && s.last_active_day >= addDays(today(), -1) ? s.streak : 0;
const tabs = [
  { href: '/app', icon: '🏠', label: 'Inicio', active: path === '/app' || path === '/app/' },
  { href: '/app/progreso', icon: '📊', label: 'Progreso', active: path.startsWith('/app/progreso') },
  { href: '/app/mapa', icon: '🗺️', label: 'Mapa', active: path.startsWith('/app/mapa') },
  { href: '/app/album', icon: '📒', label: 'Álbum', active: path.startsWith('/app/album') },
  { href: '/app/mascota', icon: '🐲', label: 'Mascota', active: path.startsWith('/app/mascota') },
];
---
<Base title={title} age={s.age_group}>
  <div class="min-h-dvh bg-gradient-to-b from-brand-50 via-[#f3f5fa] to-gold-50 pb-28 md:pb-10">
    <header class="om-night sticky top-0 z-30 shadow-md">
      <div class="mx-auto flex max-w-5xl items-center gap-3 px-4 py-2.5 md:px-6">
        <Logo href="/app" size={40} class="min-w-0" />
        <nav class="ml-6 hidden gap-1 md:flex" aria-label="Secciones">
          {tabs.map((t) => (
            <a href={t.href} aria-current={t.active ? 'page' : undefined}
              class={`inline-flex min-h-11 items-center gap-1 rounded-xl px-3 text-sm font-bold transition ${t.active ? 'bg-gold-400 text-brand-950' : 'text-brand-100 hover:bg-white/10'}`}>
              <span aria-hidden="true">{t.icon}</span> {t.label}
            </a>
          ))}
        </nav>
        <div class="ml-auto flex shrink-0 items-center gap-1.5 text-sm font-extrabold">
          <span class="rounded-full bg-white/10 px-2 py-1 tabular-nums" aria-label={`Racha: ${streak} días`} title="Días de racha">🔥 {streak}</span>
          <span class="rounded-full bg-white/10 px-2 py-1 tabular-nums" aria-label={`Nivel ${levelFromXp(s.xp)}`} title="Nivel">🏅 {levelFromXp(s.xp)}</span>
          <span class="hidden rounded-full bg-gold-400 px-2.5 py-1 text-brand-950 tabular-nums sm:inline" title="XP total">⭐ {s.xp}</span>
        </div>
      </div>
      <div class="om-meander"></div>
    </header>

    <nav class="fixed inset-x-0 bottom-0 z-30 border-t border-brand-100 bg-white/95 pb-[env(safe-area-inset-bottom)] backdrop-blur md:hidden" aria-label="Secciones">
      <div class="mx-auto flex max-w-lg items-stretch justify-around px-1 py-1.5">
        {tabs.map((t) => (
          <a href={t.href} aria-current={t.active ? 'page' : undefined}
            class={`flex min-h-12 min-w-14 flex-1 flex-col items-center justify-center rounded-2xl py-1 font-display font-bold ${t.active ? 'bg-brand-800 text-gold-200 shadow-[0_4px_0_#0b1631]' : 'text-slate-600'}`}>
            <span class="text-2xl leading-none" aria-hidden="true">{t.icon}</span><span class="mt-0.5 text-xs">{t.label}</span>
          </a>
        ))}
      </div>
    </nav>

    <main class="mx-auto max-w-5xl px-4 pt-5 md:px-6">
      <slot />
    </main>
  </div>
</Base>

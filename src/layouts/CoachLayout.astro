---
import Base from './Base.astro';
import Logo from '../components/ui/Logo.astro';
interface Props { title: string; wide?: boolean }
const { title, wide = false } = Astro.props;
const coach = Astro.locals.coach;
const path = Astro.url.pathname;
const nav = [
  { href: '/profe', label: '🏫 Mis clases', active: path === '/profe' || path.startsWith('/profe/clase') },
  { href: '/profe/actividades', label: '🧩 Actividades', active: path.startsWith('/profe/actividades') },
  { href: '/profe/campanas', label: '🗺️ Campañas', active: path.startsWith('/profe/campanas') },
];
---
<Base title={`${title} · Odisea Miranda`}>
  <div class="min-h-dvh bg-[#f3f5fa]">
    <header class="om-night sticky top-0 z-30 shadow-md">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-3 px-4 py-2.5">
        <Logo href="/profe" size={40} tag="Profes" />
        <nav class="flex flex-wrap gap-1" aria-label="Secciones">
          {nav.map((n) => <a href={n.href} aria-current={n.active ? 'page' : undefined} class={`inline-flex min-h-11 items-center rounded-xl px-3 text-sm font-bold transition ${n.active ? 'bg-gold-400 text-brand-950' : 'text-brand-100 hover:bg-white/10'}`}>{n.label}</a>)}
        </nav>
        <div class="ml-auto flex items-center gap-3 text-sm">
          <span class="hidden font-bold text-brand-100 sm:inline">{coach?.name}</span>
          <form method="post" action="/api/auth/logout?to=profe"><button class="ck-btn-sm !bg-white/10 !text-white hover:!bg-white/20">Salir</button></form>
        </div>
      </div>
      <div class="om-meander"></div>
    </header>
    <main class={`mx-auto px-4 py-6 ${wide ? 'max-w-[1600px]' : 'max-w-7xl'}`}>
      <slot />
    </main>
  </div>
  <script src="../scripts/apiform.ts"></script>
</Base>

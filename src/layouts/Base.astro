---
import '../styles/global.css';
interface Props { title?: string; age?: string; bodyClass?: string }
const { title = 'Odisea Miranda', age = 'explorador', bodyClass = '' } = Astro.props;
// Logged-in students carry their Potróculo voice here; src/lib/voice/player.ts reads it.
const voice = Astro.locals.student?.voice;
const studentId = Astro.locals.student?.id;
---
<!doctype html>
<html lang="es" data-voice={voice} data-student={studentId}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1631" />
    <meta name="description" content="Odisea Miranda: aprende ajedrez jugando. Retos, problemas y lecciones para todas las edades." />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="icon" type="image/png" sizes="48x48" href="/brand/favicon-48.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Outfit:wght@500;600;700;800&family=Nunito:wght@500;700;800;900&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body data-age={age} class={bodyClass}>
    <slot />
    {studentId && <script src="../scripts/student.ts"></script>}
  </body>
</html>

---
// Brand mark: round logo + "Odisea Miranda" wordmark. `tone` picks the wordmark color for
// dark (navy) or light backgrounds.
interface Props { href?: string; size?: number; tone?: 'dark' | 'light'; tag?: string; class?: string }
const { href = '/', size = 40, tone = 'dark', tag, class: cls = '' } = Astro.props;
const src = size > 96 ? '/brand/logo-512.webp' : size > 48 ? '/brand/logo-192.webp' : '/brand/logo-96.webp';
---
<a href={href} class={`flex items-center gap-2 ${cls}`} aria-label="Odisea Miranda · inicio">
  <img src={src} width={size} height={size} alt="" class="om-logo shrink-0" style={`width:${size}px;height:${size}px`} />
  <span class="flex min-w-0 flex-col leading-none">
    <span class={`truncate font-brand text-[15px] font-bold tracking-normal sm:text-lg sm:tracking-wide md:text-xl ${tone === 'dark' ? 'om-gold-text' : 'text-brand-900'}`}>Odisea Miranda</span>
    {tag && <span class={`mt-0.5 text-[11px] font-extrabold uppercase tracking-[0.2em] ${tone === 'dark' ? 'text-gold-200/80' : 'text-gold-700'}`}>{tag}</span>}
  </span>
</a>

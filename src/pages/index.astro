---
import Base from '../layouts/Base.astro';
if (Astro.locals.student) return Astro.redirect('/app');
if (Astro.locals.coach) return Astro.redirect('/profe');
const pieces = ['♞', '♛', '♜', '♝', '♚', '♟'];
const perks = [
  { icon: '🧩', title: 'Problemas y lecciones', text: 'Retos a tu medida, con pistas cuando las necesitas.' },
  { icon: '🏆', title: 'Recompensas', text: 'Estrellas, cromos, rachas y mapas de aventura.' },
  { icon: '📊', title: 'Progreso claro', text: 'Estadísticas para alumnos, familias y profes.' },
];
---
<Base title="Odisea Miranda · Aprende ajedrez jugando">
  <div class="om-night relative flex min-h-dvh flex-col overflow-hidden">
    {pieces.map((p, i) => (
      <span aria-hidden="true" class="ck-float pointer-events-none absolute select-none text-7xl text-gold-300/10 md:text-9xl"
        style={`left:${[6, 80, 14, 70, 44, 88][i]}%; top:${[10, 8, 72, 70, 4, 40][i]}%; animation-delay:${i * 0.5}s`}>{p}</span>
    ))}
    <div class="om-meander"></div>
    <main class="relative mx-auto flex w-full max-w-3xl flex-1 flex-col items-center justify-center px-6 py-10 text-center">
      <img src="/brand/logo-512.webp" width="220" height="220" alt="Logo de Odisea Miranda" class="om-logo ck-rise h-44 w-44 md:h-56 md:w-56" />
      <h1 class="ck-rise mt-6 font-brand text-4xl font-bold md:text-6xl" style="animation-delay:.1s"><span class="om-gold-text">Odisea Miranda</span></h1>
      <p class="ck-rise mt-3 max-w-xl text-lg font-bold text-brand-100 md:text-xl" style="animation-delay:.2s">Aprende ajedrez jugando: resuelve retos, gana estrellas y descubre nuevos reinos.</p>
      <div class="ck-rise mt-8 grid w-full max-w-xl gap-4 sm:grid-cols-2" style="animation-delay:.3s">
        <a href="/entrar" class="ck-btn ck-btn-gold py-5 text-2xl">🎒 Soy alumno</a>
        <a href="/profe/login" class="ck-btn border-2 border-gold-300/60 bg-white/5 py-5 text-2xl text-gold-100 backdrop-blur" style="box-shadow:0 5px 0 rgb(0 0 0/.3)">🧑‍🏫 Soy profe</a>
      </div>
      <ul class="ck-rise mt-10 grid w-full gap-3 text-left sm:grid-cols-3" style="animation-delay:.4s">
        {perks.map((x) => (
          <li class="rounded-2xl border border-gold-300/20 bg-white/5 p-4 backdrop-blur">
            <p class="text-2xl" aria-hidden="true">{x.icon}</p>
            <p class="mt-1 font-display font-bold text-gold-200">{x.title}</p>
            <p class="text-sm text-brand-100">{x.text}</p>
          </li>
        ))}
      </ul>
    </main>
    <footer class="relative flex justify-center gap-5 pb-4 text-sm font-bold text-brand-200">
      <a href="/privacidad" class="hover:text-gold-200">Privacidad</a>
      <a href="/aviso-legal" class="hover:text-gold-200">Aviso legal</a>
    </footer>
    <div class="om-meander"></div>
  </div>
</Base>

---
import StudentLayout from '../../../layouts/StudentLayout.astro';
import { getStudentCampaigns, CAMPAIGN_REWARDS } from '../../../lib/campaigns';
import { GAME_META } from '../../../games/meta';

const s = Astro.locals.student!;
const db = Astro.locals.db;
const campaignId = parseInt(Astro.params.id as string, 10);

// We fetch all assigned campaigns to ensure this student has access to this campaign
const campaigns = await getStudentCampaigns(db, s.class_id, s.id);
const campaign = campaigns.find(c => c.id === campaignId);

if (!campaign) {
  return Astro.redirect('/app');
}

const reward = CAMPAIGN_REWARDS.find(r => r.id === campaign.reward_type) || CAMPAIGN_REWARDS[0];
const allCompleted = campaign.nodes.length > 0 && campaign.completedNodeIds.size === campaign.nodes.length;

// Ensure nodes are sorted properly. For simplicity, we assume sequential IDs or x/y coords
const nodes = [...campaign.nodes].sort((a, b) => a.id - b.id);

---
<StudentLayout title={`${campaign.title} · ChessKids`}>
  <div class="mb-4">
    <a href="/app" class="text-sm font-bold text-violet-600 hover:underline">← Volver al inicio</a>
  </div>

  <h1 class="ck-rise text-center font-display text-4xl font-extrabold text-violet-800">{campaign.title}</h1>
  <p class="text-center font-bold text-slate-500">{campaign.description}</p>
  
  <div class="mt-4 flex items-center justify-center">
    <div class={`rounded-2xl border-4 ${allCompleted ? 'border-amber-400 bg-amber-50' : 'border-slate-200 bg-slate-50'} px-6 py-3 text-center`}>
      <p class="text-xs font-extrabold uppercase tracking-wide text-slate-500">Recompensa final</p>
      <div class="mt-1 flex items-center gap-3">
        <span class="text-4xl">{reward.emoji}</span>
        <div class="text-left">
          <p class="font-display font-extrabold text-slate-800">{reward.name}</p>
          <p class="text-xs font-bold text-slate-500">{allCompleted ? '¡Conseguida!' : 'Supera todos los niveles para ganarla'}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="relative mx-auto mt-8 max-w-lg overflow-hidden rounded-[2.5rem] bg-gradient-to-b from-green-300 via-emerald-200 to-teal-200 px-4 py-10 shadow-inner">
    <span class="ck-float absolute left-4 top-6 text-5xl opacity-70">☁️</span>
    <span class="ck-float absolute right-6 top-40 text-4xl opacity-60" style="animation-delay:1.2s">☁️</span>
    <span class="ck-float absolute left-8 top-[55%] text-4xl opacity-60" style="animation-delay:.6s">☁️</span>
    
    <div class="relative flex flex-col" style={`height: ${Math.max(600, nodes.length * 150)}px`}>
      <svg class="absolute inset-0 h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <path d={
          'M ' + nodes.map((n, idx) => {
            // Default x positions for a winding path if not set by DB
            const x = n.x_pos > 0 ? n.x_pos : (idx % 2 === 0 ? 30 : 70); 
            // We draw from bottom to top (highest index is at the top)
            const yPct = 100 - ((idx + 0.5) / nodes.length * 100);
            return `${x} ${yPct}`;
          }).join(' L ')
        } stroke="#fff" stroke-width="3" stroke-dasharray="1 3" stroke-linecap="round" fill="none" opacity=".8" vector-effect="non-scaling-stroke" />
      </svg>
      
      {nodes.map((n, idx) => {
        const isCompleted = campaign.completedNodeIds.has(n.id);
        const isNext = !isCompleted && (idx === 0 || campaign.completedNodeIds.has(nodes[idx - 1].id));
        const isLocked = !isCompleted && !isNext;
        
        const x = n.x_pos > 0 ? n.x_pos : (idx % 2 === 0 ? 30 : 70);
        // Calculate top based on percentage so it matches the SVG
        const yPct = 100 - ((idx + 0.5) / nodes.length * 100);
        
        const meta = GAME_META[n.activity_type];
        
        return (
          <div class="absolute flex -translate-x-1/2 -translate-y-1/2 flex-col items-center" style={`left:${x}%; top:${yPct}%`}>
            {isNext && <span class="absolute -top-12 animate-bounce text-5xl drop-shadow-lg">{s.avatar}</span>}
            
            <a href={isLocked ? '#' : `/app/jugar/${n.activity_id}?camp=${n.id}`} class={`group relative flex h-20 w-20 items-center justify-center rounded-full border-4 text-4xl shadow-[0_6px_0_rgb(0_0_0/0.2)] transition-transform ${!isLocked ? 'hover:-translate-y-1 hover:scale-105 active:translate-y-1' : 'cursor-not-allowed'} ${isCompleted ? 'border-amber-400 bg-amber-300' : isNext ? 'border-violet-400 bg-white ring-8 ring-violet-300/50' : 'border-slate-300 bg-slate-200 grayscale'}`}>
              {isCompleted ? '⭐' : isLocked ? '🔒' : (meta?.emoji || '🎮')}
            </a>
            
            <div class={`mt-2 whitespace-nowrap rounded-full px-3 py-1 text-center text-xs font-extrabold shadow ${isCompleted ? 'bg-amber-100 text-amber-800' : isNext ? 'bg-white text-violet-700' : 'bg-slate-200 text-slate-500'}`}>
              Nivel {idx + 1}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</StudentLayout>

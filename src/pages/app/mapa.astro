---
import StudentLayout from '../../layouts/StudentLayout.astro';
import { KINGDOMS, kingdomIndex } from '../../lib/rewards';
const s = Astro.locals.student!;
const cur = kingdomIndex(s.xp);
// Winding path: x positions (%) for each kingdom node, bottom (start) to top.
const xs = [50, 22, 70, 30, 76, 24, 68, 50];
const list = KINGDOMS.map((k, i) => ({ ...k, i, x: xs[i] })).reverse();
---
<StudentLayout title="Mapa · ChessKids">
  <h1 class="ck-rise text-center font-display text-4xl font-extrabold text-violet-800">🗺️ Mapa de los reinos</h1>
  <p class="text-center font-bold text-slate-500">Gana XP para viajar a nuevos reinos</p>
  <div class="relative mx-auto mt-6 max-w-lg overflow-hidden rounded-[2.5rem] bg-gradient-to-b from-indigo-300 via-sky-200 to-lime-200 px-4 py-10 shadow-inner">
    <span class="ck-float absolute left-4 top-6 text-5xl opacity-70">☁️</span>
    <span class="ck-float absolute right-6 top-40 text-4xl opacity-60" style="animation-delay:1.2s">☁️</span>
    <span class="ck-float absolute left-8 top-[55%] text-4xl opacity-60" style="animation-delay:.6s">☁️</span>
    <div class="relative flex flex-col" style="height: 1140px">
      <svg class="absolute inset-0 h-full w-full" viewBox="0 0 100 1140" preserveAspectRatio="none" aria-hidden="true">
      <path d={'M ' + list.map((k, idx) => `${k.x} ${60 + idx * 145}`).join(' L ')} stroke="#fff" stroke-width="3.5" stroke-dasharray="1 5" stroke-linecap="round" fill="none" opacity=".9" vector-effect="non-scaling-stroke" />
    </svg>
      {list.map((k, idx) => {
        const unlocked = cur >= k.i;
        const here = k.i === cur;
        return (
          <div class="absolute flex -translate-x-1/2 -translate-y-1/2 flex-col items-center" style={`left:${k.x}%; top:${60 + idx * 145}px`}>
            {here && <span class="absolute -top-14 animate-bounce text-5xl drop-shadow-lg">{s.avatar}</span>}
            <div class={`flex h-20 w-20 items-center justify-center rounded-full border-4 text-5xl shadow-[0_6px_0_rgb(0_0_0/0.2)] ${unlocked ? 'bg-white' : 'bg-slate-300 grayscale'} ${here ? 'ring-8 ring-amber-300/70' : ''}`} style={unlocked ? `border-color:${k.color}` : 'border-color:#94a3b8'}>
              {unlocked ? k.emoji : '🔒'}
            </div>
            <div class={`mt-1 whitespace-nowrap rounded-full px-3 py-0.5 text-center text-sm font-extrabold shadow ${unlocked ? 'bg-white' : 'bg-white/70 text-slate-500'}`} style={unlocked ? `color:${k.color}` : ''}>
              {k.name}
            </div>
            {!unlocked && <div class="mt-0.5 rounded-full bg-slate-700/70 px-2 text-xs font-bold text-white">{k.xp} XP</div>}
          </div>
        );
      })}
    </div>
  </div>
  <p class="mt-4 text-center font-bold text-slate-600">Tienes <span class="text-violet-600">{s.xp} XP</span></p>
</StudentLayout>

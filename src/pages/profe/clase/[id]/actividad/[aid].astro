---
import CoachLayout from '../../../../../layouts/CoachLayout.astro';
import MiniBoard from '../../../../../components/coach/MiniBoard.astro';
import ReviewBuilder from '../../../../../components/coach/ReviewBuilder';
import { GAME_META } from '../../../../../games/meta';
import { classPerm, type ActivityRow, type ClassRow } from '../../../../../lib/db';
import { cellState, failRate, themeStats, type Cell } from '../../../../../lib/insights';
import { PUZZLE_TYPES } from '../../../../../lib/practice';

const coach = Astro.locals.coach!;
const db = Astro.locals.db;
const classId = Number(Astro.params.id);
const activityId = Number(Astro.params.aid);
const perm = await classPerm(db, coach.id, classId);
if (!perm || !(perm.is_owner || perm.can_view_progress)) return Astro.redirect('/profe');
const [cls, activity] = await Promise.all([
  db.prepare('SELECT * FROM classes WHERE id = ?').bind(classId).first<ClassRow>(),
  db.prepare('SELECT * FROM activities WHERE id = ?').bind(activityId).first<ActivityRow>(),
]);
if (!cls || !activity || activity.club_id !== cls.club_id || (activity.visibility === 'private' && activity.created_by !== coach.id)) {
  return Astro.redirect(`/profe/clase/${classId}?tab=progreso`);
}
const canCreate = !!(perm.is_owner || perm.can_create_content);
const meta = GAME_META[activity.type];
const content = (() => { try { return JSON.parse(activity.content_json); } catch { return {}; } })();
const count = (() => { try { return meta?.count(content) ?? 0; } catch { return 0; } })();
const isPuzzle = PUZZLE_TYPES.includes(activity.type);

const [studentsRes, cellsRes, attemptsRes] = await db.batch<any>([
  db.prepare('SELECT id, display_name, avatar FROM students WHERE class_id = ? AND archived = 0 ORDER BY display_name').bind(classId),
  // First result per (student, item) + how many tries and successes (homework and review).
  db.prepare(
    `SELECT x.student_id, x.item, r.ok AS first_ok, x.oks, x.tries FROM (
       SELECT student_id, item, MIN(id) AS first_id, SUM(ok) AS oks, COUNT(*) AS tries FROM item_results
       WHERE activity_id = ? AND source IN ('activity', 'repaso') AND student_id IN (SELECT id FROM students WHERE class_id = ? AND archived = 0)
       GROUP BY student_id, item) x JOIN item_results r ON r.id = x.first_id`,
  ).bind(activityId, classId),
  db.prepare(
    `SELECT at.student_id, COUNT(*) AS plays, MAX(at.stars) AS stars, SUM(at.seconds) AS seconds FROM attempts at
     WHERE at.activity_id = ? AND at.student_id IN (SELECT id FROM students WHERE class_id = ? AND archived = 0) GROUP BY at.student_id`,
  ).bind(activityId, classId),
]);
const students = studentsRes.results as { id: number; display_name: string; avatar: string }[];
const cells = new Map<string, Cell>((cellsRes.results as any[]).map((r) => [`${r.student_id}:${r.item}`, { firstOk: !!r.first_ok, oks: r.oks, tries: r.tries }]));
const plays = new Map<number, { plays: number; stars: number; seconds: number }>((attemptsRes.results as any[]).map((r) => [r.student_id, r]));
const items = Array.from({ length: Math.min(count, 60) }, (_, i) => {
  const rate = failRate(students.map((s) => cells.get(`${s.id}:${i}`)));
  return { i, rate, puzzle: isPuzzle ? content.puzzles?.[i] : null };
});
const hardest = items.filter((it) => it.rate !== null && it.rate > 0).sort((a, b) => (b.rate ?? 0) - (a.rate ?? 0)).slice(0, 6);
const failedItems = items.filter((it) => (it.rate ?? 0) > 0).length;

// Weak themes for puzzles that came from Lichess (first try of each student).
let themes: ReturnType<typeof themeStats> = [];
const lichessIds = isPuzzle ? [...new Set((content.puzzles ?? []).map((p: any) => p?.lichessId).filter(Boolean))] as string[] : [];
if (lichessIds.length) {
  const { results } = await db.prepare(`SELECT id, themes FROM lichess_puzzles WHERE id IN (${lichessIds.map(() => '?').join(',')})`).bind(...lichessIds).all<{ id: string; themes: string }>();
  const byId = new Map(results.map((r) => [r.id, r.themes]));
  const rows: { themes: string; ok: boolean }[] = [];
  (content.puzzles as any[]).forEach((p, i) => {
    const th = p?.lichessId && byId.get(p.lichessId);
    if (!th) return;
    for (const s of students) { const c = cells.get(`${s.id}:${i}`); if (c) rows.push({ themes: th, ok: c.firstOk }); }
  });
  themes = themeStats(rows, 2).slice(0, 6);
}

const cellStyle = { ok: 'bg-emerald-400 text-emerald-950', fixed: 'bg-amber-300 text-amber-950', fail: 'bg-rose-600 text-white', none: 'bg-slate-100 text-slate-400' } as const;
const cellGlyph = { ok: '✓', fixed: '↻', fail: '✕', none: '·' } as const;
const cellLabel = { ok: 'Bien a la primera', fixed: 'Falló, pero luego lo resolvió', fail: 'Fallado', none: 'Sin jugar' } as const;
const label = isPuzzle ? 'Problema' : activity.type === 'pgn-lesson' ? 'Pregunta' : activity.type === 'fruit-collector' ? 'Nivel' : 'Posición';
const fmtTime = (s: number) => (s >= 60 ? `${Math.round(s / 60)} min` : `${s} s`);
const pct = (r: number | null) => (r === null ? '—' : `${Math.round(r * 100)}%`);
---
<CoachLayout title={`${activity.title} · ${cls.name}`} wide>
  <a href={`/profe/clase/${classId}?tab=progreso`} class="text-sm font-bold text-brand-600 hover:underline">← {cls.emoji} {cls.name} · Progreso</a>
  <div class="mt-2 flex flex-wrap items-center gap-3">
    <span class={`flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br ${meta?.gradient} text-3xl`}>{meta?.emoji}</span>
    <div class="flex-1">
      <h1 class="font-display text-3xl font-extrabold">{activity.title}</h1>
      <p class="text-sm text-slate-500">{meta?.name} · {count} {meta?.countLabel} · {plays.size}/{students.length} alumnos la han jugado</p>
    </div>
    <a href={`/profe/actividades/${activityId}/probar`} class="ck-btn-sm">▶ Probar</a>
  </div>

  {!cells.size ? (
    <p class="ck-card mt-6 text-slate-500">Aún no hay resultados detallados de esta actividad. Aparecerán cuando los alumnos la jueguen (los resultados anteriores a esta versión solo guardan el total).</p>
  ) : (
    <div class="mt-6 grid gap-6 xl:grid-cols-[1fr_380px]">
      <div class="space-y-6">
        <!-- Heatmap -->
        <section class="ck-card overflow-x-auto !p-0">
          <div class="flex flex-wrap items-center gap-3 border-b border-slate-100 p-4 text-xs font-bold text-slate-600">
            <h2 class="mr-auto font-display text-xl font-extrabold text-slate-800">🔬 {label} a {label.toLowerCase()}</h2>
            {(['ok', 'fixed', 'fail', 'none'] as const).map((k) => <span class="flex items-center gap-1"><span class={`inline-flex h-5 w-5 items-center justify-center rounded text-xs font-black ${cellStyle[k]}`}>{cellGlyph[k]}</span>{cellLabel[k]}</span>)}
          </div>
          <table class="w-full text-sm">
            <thead class="bg-slate-50 text-xs text-slate-500">
              <tr>
                <th class="sticky left-0 bg-slate-50 p-2 text-left">Alumno</th>
                {items.map((it) => <th class="p-1 text-center font-bold" title={`${label} ${it.i + 1}`}>{it.i + 1}</th>)}
                <th class="p-2 text-right">⭐ · ⏱️</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {students.map((s) => {
                const p = plays.get(s.id);
                return (
                  <tr>
                    <td class="sticky left-0 whitespace-nowrap bg-white p-2 font-bold"><a class="hover:underline" href={`/profe/clase/${classId}/alumno/${s.id}`}><span class="mr-1">{s.avatar}</span>{s.display_name}</a></td>
                    {items.map((it) => {
                      const c = cells.get(`${s.id}:${it.i}`);
                      const st = cellState(c);
                      return <td class="p-1 text-center"><span class={`inline-flex h-7 w-7 items-center justify-center rounded-md text-sm font-black ${cellStyle[st]}`} title={`${label} ${it.i + 1}: ${cellLabel[st]}${c ? ` (${c.tries} ${c.tries === 1 ? 'intento' : 'intentos'})` : ''}`} aria-label={cellLabel[st]}>{cellGlyph[st]}</span></td>;
                    })}
                    <td class="whitespace-nowrap p-2 text-right text-xs text-slate-500">{p ? `${'⭐'.repeat(p.stars) || '✔️'} · ${fmtTime(p.seconds)}` : '—'}</td>
                  </tr>
                );
              })}
              <tr class="bg-slate-50 text-xs font-bold text-slate-600">
                <td class="sticky left-0 bg-slate-50 p-2">% fallo a la 1ª</td>
                {items.map((it) => <td class={`p-1 text-center ${(it.rate ?? 0) >= 0.5 ? 'text-rose-600' : ''}`}>{pct(it.rate)}</td>)}
                <td></td>
              </tr>
            </tbody>
          </table>
        </section>

        {hardest.length > 0 && (
          <section class="ck-card">
            <h2 class="font-display text-xl font-extrabold">🧗 Lo que más les ha costado</h2>
            <div class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {hardest.map((it) => (
                <div class="flex items-center gap-3 rounded-2xl bg-slate-50 p-3">
                  {it.puzzle?.fen ? <MiniBoard fen={it.puzzle.fen} size={96} /> : <span class="flex h-24 w-24 items-center justify-center rounded-xl bg-white text-4xl">{meta?.emoji}</span>}
                  <div>
                    <p class="font-bold">{label} {it.i + 1}</p>
                    <p class="font-display text-2xl font-extrabold text-rose-600">{pct(it.rate)}</p>
                    <p class="text-xs text-slate-500">fallan a la primera</p>
                    {it.puzzle?.prompt && <p class="mt-1 text-xs text-slate-600">«{it.puzzle.prompt}»</p>}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="space-y-6">
        {themes.length > 0 && (
          <section class="ck-card">
            <h2 class="font-display text-xl font-extrabold">🎯 Temas a reforzar</h2>
            <p class="text-xs text-slate-500">Según los temas de Lichess de cada problema.</p>
            <ul class="mt-3 space-y-2">
              {themes.map((th) => (
                <li class="flex items-center gap-2 text-sm">
                  <span class="w-7 text-xl">{th.emoji}</span>
                  <span class="flex-1 font-bold">{th.label}</span>
                  <span class="h-2 w-24 overflow-hidden rounded-full bg-slate-100"><span class="block h-full rounded-full bg-rose-400" style={`width:${th.rate * 100}%`}></span></span>
                  <span class="w-10 text-right text-xs font-bold tabular-nums">{pct(th.rate)}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
        {isPuzzle && <ReviewBuilder client:visible classId={classId} activityId={activityId} canCreate={canCreate} failedItems={failedItems} />}
      </aside>
    </div>
  )}
</CoachLayout>

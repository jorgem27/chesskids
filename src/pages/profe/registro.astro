---
import Base from '../../layouts/Base.astro';
if (Astro.locals.coach) return Astro.redirect('/profe');
---
<Base title="Registro profes · Odisea Miranda">
  <div class="om-night flex min-h-dvh flex-col items-center justify-center gap-5 p-4">
    <a href="/" class="flex flex-col items-center gap-2"><img src="/brand/logo-192.webp" width="88" height="88" alt="" class="om-logo" /><span class="font-brand text-2xl font-bold om-gold-text">Odisea Miranda</span></a>
    <form data-api="/api/auth/coach-register" data-redirect="/profe" class="ck-card w-full max-w-sm space-y-3 text-slate-800">
      <a href="/profe/login" class="text-sm font-bold text-brand-600">← Ya tengo cuenta</a>
      <h1 class="font-display text-3xl font-extrabold text-brand-800">Crea tu cuenta de profe</h1>
      <input name="name" required placeholder="Tu nombre" class="ck-input w-full" />
      <input name="email" type="email" required placeholder="Email" class="ck-input w-full" />
      <input name="password" type="password" required minlength="8" placeholder="Contraseña (mín. 8)" class="ck-input w-full" autocomplete="new-password" />
      <input name="clubName" placeholder="Nombre de tu club (opcional)" class="ck-input w-full" />
      <p class="text-xs text-slate-500">Si vas a unirte al club de otro profe, deja el club vacío: él te dará acceso a su clase.</p>
      <p data-error class="text-sm font-bold text-rose-600"></p>
      <button type="submit" class="ck-btn ck-btn-primary w-full">Crear cuenta</button>
    </form>
  </div>
  <script src="../../scripts/apiform.ts"></script>
</Base>

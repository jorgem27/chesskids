---
import Base from '../../layouts/Base.astro';
if (Astro.locals.coach) return Astro.redirect('/profe');
---
<Base title="Acceso profes · Odisea Miranda">
  <div class="om-night flex min-h-dvh flex-col items-center justify-center gap-5 p-4">
    <a href="/" class="flex flex-col items-center gap-2"><img src="/brand/logo-192.webp" width="88" height="88" alt="" class="om-logo" /><span class="font-brand text-2xl font-bold om-gold-text">Odisea Miranda</span></a>
    <form data-api="/api/auth/coach-login" data-redirect="/profe" class="ck-card w-full max-w-sm space-y-3 text-slate-800">
      <a href="/" class="text-sm font-bold text-brand-600">← Inicio</a>
      <h1 class="font-display text-3xl font-extrabold text-brand-800">🧑‍🏫 Acceso profes</h1>
      <input name="email" type="email" required placeholder="Email" class="ck-input w-full" autocomplete="username" />
      <input name="password" type="password" required placeholder="Contraseña" class="ck-input w-full" autocomplete="current-password" />
      <p data-error class="text-sm font-bold text-rose-600"></p>
      <button type="submit" class="ck-btn ck-btn-primary w-full">Entrar</button>
      <p class="text-center text-sm"><a href="/profe/recuperar" class="font-bold text-brand-600">¿Olvidaste tu contraseña?</a></p>
      <p class="text-center text-sm text-slate-500">¿Te han invitado? <a href="/profe/registro" class="font-bold text-brand-600">Crea tu cuenta</a></p>
      <p class="flex justify-center gap-4 text-xs text-slate-500"><a href="/privacidad">Privacidad</a><a href="/aviso-legal">Aviso legal</a></p>
    </form>
  </div>
  <script src="../../scripts/apiform.ts"></script>
</Base>

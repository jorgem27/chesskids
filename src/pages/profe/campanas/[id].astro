---
import CoachLayout from '../../../layouts/CoachLayout.astro';
import CampaignEditor from '../../../components/coach/CampaignEditor';
import { coachClasses, VISIBLE_ACTIVITY_SQL } from '../../../lib/db';
import { coachCampaign, getCampaignNodes } from '../../../lib/campaigns';

type Lib = { id: number; title: string; type: string; visibility: string };

const coach = Astro.locals.coach!;
const db = Astro.locals.db;
// Only coaches of the campaign's club can open it.
const acc = await coachCampaign(db, coach.id, Number(Astro.params.id));
if (!acc) return Astro.redirect('/profe/campanas');
const { campaign, canEdit } = acc;

const [nodes, allClasses, assignedRes, library] = await Promise.all([
  getCampaignNodes(db, campaign.id),
  coachClasses(db, coach.id),
  db.prepare('SELECT class_id FROM class_campaigns WHERE campaign_id = ?').bind(campaign.id).all<{ class_id: number }>(),
  canEdit
    ? db.prepare('SELECT a.id, a.title, a.type, a.visibility FROM activities a WHERE a.club_id = ? AND ' + VISIBLE_ACTIVITY_SQL + ' ORDER BY a.updated_at DESC LIMIT 300')
        .bind(campaign.club_id, coach.id).all<Lib>().then((r) => r.results)
    : Promise.resolve([] as Lib[]),
]);
const assigned = new Set(assignedRes.results.map((a) => a.class_id));
const clubClasses = allClasses.filter((c) => c.club_id === campaign.club_id);
const classes = clubClasses.map((c) => ({
  id: c.id, name: c.name, emoji: c.emoji, assigned: assigned.has(c.id), canAssign: !!(c.is_owner || c.can_create_content),
}));

// Progress of the assigned classes whose progress this coach may see.
const visible = clubClasses.filter((c) => assigned.has(c.id) && (c.is_owner || c.can_view_progress));
let progress: { classId: number; className: string; students: { name: string; avatar: string; done: number }[] }[] = [];
if (visible.length) {
  const { results } = await db.prepare(
    `SELECT s.class_id, s.display_name AS name, s.avatar,
       (SELECT COUNT(*) FROM campaign_progress p JOIN campaign_nodes n ON n.id = p.node_id WHERE p.student_id = s.id AND n.campaign_id = ?) AS done
     FROM students s WHERE s.archived = 0 AND s.class_id IN (${visible.map(() => '?').join(',')}) ORDER BY done DESC, s.display_name`,
  ).bind(campaign.id, ...visible.map((c) => c.id)).all<{ class_id: number; name: string; avatar: string; done: number }>();
  progress = visible.map((c) => ({ classId: c.id, className: `${c.emoji} ${c.name}`, students: results.filter((r) => r.class_id === c.id) }));
}
---
<CoachLayout title={campaign.title} wide>
  <a href="/profe/campanas" class="text-sm font-bold text-brand-600 hover:underline">← Volver a Campañas</a>
  <h1 class="mb-5 mt-2 font-display text-3xl font-extrabold text-slate-800">{campaign.emoji} {campaign.title}</h1>
  <CampaignEditor client:load clubId={campaign.club_id} canEdit={canEdit}
    campaign={{ id: campaign.id, title: campaign.title, description: campaign.description, reward_type: campaign.reward_type, theme: campaign.theme, emoji: campaign.emoji }}
    nodes={nodes.map((n) => ({ id: n.id, activityId: n.activity_id, title: n.activity_title, type: n.activity_type }))}
    library={library} classes={classes} progress={progress} />
</CoachLayout>

---
import CoachLayout from '../../../layouts/CoachLayout.astro';
import { coachClubs } from '../../../lib/db';
import { CAMPAIGN_REWARDS } from '../../../lib/campaigns';

const coach = Astro.locals.coach!;
const db = Astro.locals.db;
const clubs = await coachClubs(db, coach.id);
if (!clubs.length) return Astro.redirect('/profe');
const clubId = clubs[0].id;

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const title = data.get('title') as string;
  const description = data.get('description') as string;
  const reward_type = data.get('reward_type') as string;
  
  if (title && reward_type) {
    const { results } = await db.prepare(
      'INSERT INTO campaigns (club_id, created_by, title, description, reward_type) VALUES (?, ?, ?, ?, ?) RETURNING id'
    ).bind(clubId, coach.id, title, description, reward_type).all<{id: number}>();
    
    return Astro.redirect(`/profe/campanas/${results[0].id}`);
  }
}
---
<CoachLayout title="Nueva Campaña">
  <div class="mb-5">
    <a href="/profe/campanas" class="text-sm font-bold text-violet-600 hover:underline">← Volver a Campañas</a>
  </div>

  <form method="post" class="ck-card mx-auto max-w-lg space-y-4">
    <h1 class="font-display text-2xl font-extrabold text-slate-800">🗺️ Crear nueva campaña</h1>
    
    <label class="block">
      <span class="text-sm font-bold text-slate-700">Título de la campaña</span>
      <input type="text" name="title" required placeholder="Ej: Aventuras Tácticas" class="ck-input w-full mt-1" />
    </label>

    <label class="block">
      <span class="text-sm font-bold text-slate-700">Descripción (opcional)</span>
      <input type="text" name="description" placeholder="Ej: Resuelve estos problemas para avanzar." class="ck-input w-full mt-1" />
    </label>

    <div class="block">
      <span class="text-sm font-bold text-slate-700 mb-2 block">Recompensa final (elige una)</span>
      <div class="space-y-2">
        {CAMPAIGN_REWARDS.map((r, i) => (
          <label class={`flex cursor-pointer items-center gap-3 rounded-xl border-2 border-slate-200 p-3 transition hover:bg-slate-50 [&:has(input:checked)]:border-violet-500 [&:has(input:checked)]:bg-violet-50`}>
            <input type="radio" name="reward_type" value={r.id} required checked={i === 0} class="h-4 w-4 text-violet-600" />
            <span class="text-3xl">{r.emoji}</span>
            <div>
              <p class="font-bold text-slate-800">{r.name}</p>
              <p class="text-xs text-slate-500">{r.description}</p>
            </div>
          </label>
        ))}
      </div>
    </div>

    <button type="submit" class="ck-btn ck-btn-primary w-full text-lg">Guardar campaña</button>
  </form>
</CoachLayout>

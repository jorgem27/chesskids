---
import CoachLayout from '../../../layouts/CoachLayout.astro';
import CampaignEditor from '../../../components/coach/CampaignEditor';
import { coachClubs, VISIBLE_ACTIVITY_SQL } from '../../../lib/db';

const coach = Astro.locals.coach!;
const db = Astro.locals.db;
const clubs = await coachClubs(db, coach.id);
if (!clubs.length) return Astro.redirect('/profe');
const club = clubs.find((c) => c.id === Number(Astro.url.searchParams.get('club'))) ?? clubs[0];
const { results: library } = await db.prepare(
  'SELECT a.id, a.title, a.type, a.visibility FROM activities a WHERE a.club_id = ? AND ' + VISIBLE_ACTIVITY_SQL + ' ORDER BY a.updated_at DESC LIMIT 300',
).bind(club.id, coach.id).all<{ id: number; title: string; type: string; visibility: string }>();
---
<CoachLayout title="Nueva campaña" wide>
  <a href={`/profe/campanas?club=${club.id}`} class="text-sm font-bold text-brand-600 hover:underline">← Volver a Campañas</a>
  <h1 class="mb-5 mt-2 font-display text-3xl font-extrabold text-slate-800">🗺️ Nueva campaña{clubs.length > 1 && <span class="text-lg text-slate-500"> · {club.name}</span>}</h1>
  <CampaignEditor client:load clubId={club.id} canEdit={true} campaign={null} nodes={[]} library={library} classes={[]} progress={[]} />
</CoachLayout>

---
import CoachLayout from '../../../layouts/CoachLayout.astro';
import { coachClubs } from '../../../lib/db';
import { getCampaigns, rewardById, themeById } from '../../../lib/campaigns';

const coach = Astro.locals.coach!;
const db = Astro.locals.db;
const clubs = await coachClubs(db, coach.id);
if (!clubs.length) return Astro.redirect('/profe');
const club = clubs.find((c) => c.id === Number(Astro.url.searchParams.get('club'))) ?? clubs[0];
const campaigns = await getCampaigns(db, club.id);
---
<CoachLayout title="Campañas">
  <div class="mb-5 flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="font-display text-3xl font-extrabold text-slate-800">🗺️ Campañas</h1>
      <p class="text-sm text-slate-500">Mapas de aventura: actividades en orden, con un premio al final.</p>
    </div>
    <a href={`/profe/campanas/nueva?club=${club.id}`} class="ck-btn ck-btn-primary">➕ Crear campaña</a>
  </div>

  {clubs.length > 1 && (
    <nav class="mb-4 flex flex-wrap gap-2">
      {clubs.map((c) => <a href={`?club=${c.id}`} class={`rounded-2xl px-4 py-2 font-bold ${c.id === club.id ? 'bg-violet-600 text-white' : 'bg-white text-slate-600 ring-1 ring-slate-200'}`}>{c.name}</a>)}
    </nav>
  )}

  {campaigns.length === 0 ? (
    <div class="ck-card text-center">
      <p class="text-5xl">🗺️</p>
      <p class="mt-2 font-bold text-slate-600">Aún no hay campañas. Crea una para agrupar actividades en un mapa de aventura.</p>
    </div>
  ) : (
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {campaigns.map((c) => {
        const reward = rewardById(c.reward_type);
        const theme = themeById(c.theme);
        const dark = theme.id === 'espacio' || theme.id === 'volcan';
        return (
          <a href={`/profe/campanas/${c.id}`} class="ck-card ck-rise group block !p-0 overflow-hidden transition hover:-translate-y-1 hover:shadow-lg">
            <div class={`relative flex items-center gap-3 p-4 ${dark ? 'text-white' : 'text-slate-800'}`} style={`background:${theme.bg}`}>
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/80 text-3xl">{c.emoji}</span>
              <h2 class="font-display text-xl font-extrabold leading-tight">{c.title}</h2>
              <span class="absolute right-3 top-1 text-5xl opacity-30" aria-hidden="true">{theme.goal}</span>
            </div>
            <div class="p-4">
              {c.description && <p class="text-sm text-slate-600">{c.description}</p>}
              <div class="mt-2 flex flex-wrap gap-2 text-xs font-bold">
                <span class="rounded-full bg-slate-100 px-2 py-1">🧗 {c.node_count} {c.node_count === 1 ? 'nivel' : 'niveles'}</span>
                <span class="rounded-full bg-slate-100 px-2 py-1">🏫 {c.class_count} {c.class_count === 1 ? 'clase' : 'clases'}</span>
                <span class="rounded-full bg-amber-100 px-2 py-1 text-amber-800">{reward.emoji} {reward.name}</span>
              </div>
              <p class="mt-3 text-right text-sm font-bold text-violet-600 group-hover:underline">Abrir ➔</p>
            </div>
          </a>
        );
      })}
    </div>
  )}
</CoachLayout>

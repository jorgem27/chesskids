---
import CoachLayout from '../../../layouts/CoachLayout.astro';
import { coachClubs } from '../../../lib/db';
import { getCampaigns, CAMPAIGN_REWARDS, type CampaignRow } from '../../../lib/campaigns';

const coach = Astro.locals.coach!;
const db = Astro.locals.db;
const clubs = await coachClubs(db, coach.id);
if (!clubs.length) return Astro.redirect('/profe');
const clubId = clubs[0].id; // Simple for MVP

const campaigns = await getCampaigns(db, clubId);
---
<CoachLayout title="Campañas">
  <div class="mb-5 flex flex-wrap items-center justify-between gap-4">
    <h1 class="font-display text-3xl font-extrabold text-slate-800">🗺️ Campañas (Mapas de Aventura)</h1>
    <a href="/profe/campanas/nueva" class="ck-btn ck-btn-primary">➕ Crear Campaña</a>
  </div>

  {campaigns.length === 0 ? (
    <div class="ck-card text-center">
      <p class="text-4xl">🗺️</p>
      <p class="mt-2 font-bold text-slate-600">Aún no hay campañas. Crea una para agrupar actividades en un mapa.</p>
    </div>
  ) : (
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {campaigns.map((c: CampaignRow) => {
        const reward = CAMPAIGN_REWARDS.find(r => r.id === c.reward_type) || CAMPAIGN_REWARDS[0];
        return (
          <a href={`/profe/campanas/${c.id}`} class="ck-card ck-rise group block transition hover:-translate-y-1 hover:shadow-lg">
            <h2 class="font-display text-xl font-extrabold text-violet-700 group-hover:underline">{c.title}</h2>
            {c.description && <p class="mt-1 text-sm text-slate-600">{c.description}</p>}
            <div class="mt-3 flex items-center gap-2 rounded-xl bg-slate-50 p-2 text-sm">
              <span class="text-2xl">{reward.emoji}</span>
              <div>
                <p class="font-bold text-slate-800">Recompensa</p>
                <p class="text-xs text-slate-500">{reward.name}</p>
              </div>
            </div>
            <p class="mt-3 text-right text-sm font-bold text-violet-600">Editar mapa ➔</p>
          </a>
        );
      })}
    </div>
  )}
</CoachLayout>

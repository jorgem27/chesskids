---
import CoachLayout from '../../../../layouts/CoachLayout.astro';
import ActivityEditor from '../../../../components/coach/ActivityEditor';
import { activityAccess } from '../../../../lib/db';
const acc = await activityAccess(Astro.locals.db, Astro.locals.coach!.id, Number(Astro.params.id));
if (!acc) return Astro.redirect('/profe/actividades');
const a = acc.activity;
---
<CoachLayout title={`Editar · ${a.title}`}>
  <ActivityEditor client:only="preact" id={a.id} clubId={a.club_id} type={a.type} visibility={a.visibility} willFork={acc.needsFork} isAdmin={!acc.needsFork && a.visibility === 'public'}
    initial={{ title: a.title, description: a.description, xpReward: a.xp_reward, content: JSON.parse(a.content_json) }} />
</CoachLayout>

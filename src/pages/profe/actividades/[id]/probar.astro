---
import Base from '../../../../layouts/Base.astro';
import GamePlayer from '../../../../components/game/GamePlayer';
import { canEditActivity } from '../../../../lib/db';
const a = await canEditActivity(Astro.locals.db, Astro.locals.coach!.id, Number(Astro.params.id));
if (!a) return Astro.redirect('/profe/actividades');
const back = Astro.request.headers.get('referer')?.includes('/profe/') ? new URL(Astro.request.headers.get('referer')!).pathname + new URL(Astro.request.headers.get('referer')!).search : '/profe/actividades';
---
<Base title={`Probar · ${a.title}`}>
  <GamePlayer client:only="preact" preview activity={{ id: a.id, type: a.type, title: a.title, content: JSON.parse(a.content_json) }} ageGroup="explorador" exitUrl={back} />
</Base>

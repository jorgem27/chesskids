---
import Base from '../../layouts/Base.astro';
if (Astro.locals.coach) return Astro.redirect('/profe');
---
<Base title="Recuperar contraseña · Odisea Miranda">
  <div class="om-night flex min-h-dvh flex-col items-center justify-center gap-5 p-4">
    <a href="/" class="flex flex-col items-center gap-2"><img src="/brand/logo-192.webp" width="88" height="88" alt="" class="om-logo" /><span class="font-brand text-2xl font-bold om-gold-text">Odisea Miranda</span></a>
    <form id="forgot" class="ck-card w-full max-w-sm space-y-3 text-slate-800">
      <a href="/profe/login" class="text-sm font-bold text-brand-600">← Volver a entrar</a>
      <h1 class="font-display text-3xl font-extrabold text-brand-800">🔑 ¿Olvidaste tu contraseña?</h1>
      <p class="text-sm text-slate-600">Escribe tu email y te enviaremos un enlace para elegir una nueva.</p>
      <input name="email" type="email" required placeholder="Email" class="ck-input w-full" autocomplete="username" />
      <p data-error class="text-sm font-bold text-rose-600"></p>
      <button type="submit" class="ck-btn ck-btn-primary w-full">Enviar enlace</button>
      <div data-done hidden class="rounded-2xl bg-emerald-50 p-3 text-sm text-emerald-800"></div>
      <p class="text-xs text-slate-500">¿No te llega? Quien administra tu club puede crearte un enlace desde <b>🏛️ Mi club → Profes</b>.</p>
    </form>
  </div>
  <script>
    const form = document.getElementById('forgot') as HTMLFormElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = form.querySelector<HTMLElement>('[data-error]')!;
      const done = form.querySelector<HTMLElement>('[data-done]')!;
      const btn = form.querySelector<HTMLButtonElement>('button')!;
      err.textContent = '';
      btn.disabled = true;
      const res = await fetch('/api/auth/forgot', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email: new FormData(form).get('email') }) });
      const body = (await res.json().catch(() => ({}))) as { error?: string; mail?: boolean };
      btn.disabled = false;
      if (!res.ok) { err.textContent = body.error ?? 'Algo ha fallado'; return; }
      done.hidden = false;
      done.textContent = body.mail
        ? '📬 Si ese email tiene cuenta, te acabamos de enviar un enlace. Mira también en la carpeta de spam. Caduca en 1 hora.'
        : '🏛️ Esta instalación no envía emails. Pide a quien administra tu club que te cree un enlace para cambiar la contraseña desde «Mi club → Profes».';
    });
  </script>
</Base>

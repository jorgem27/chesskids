{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chesskids-academy",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chesskids",
      // Replace with the id printed by: npx wrangler d1 create chesskids
      "database_id": "c3a4522d-7143-4915-8be2-347f4e53ed91",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
